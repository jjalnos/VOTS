# Public presentation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMING_SOON=true

# Development-only authentication (never enable in production)
DEV_AUTH_ENABLED=true
AUTH_PROVIDER=development
AUTH_SESSION_SECRET=replace-with-a-long-random-local-development-value

# Temporary staging policy. Set true before production staff access is enabled.
STAFF_MFA_REQUIRED=false

# Staff MFA verification hook. Required when STAFF_MFA_REQUIRED=true.
MFA_PROVIDER=unconfigured
MFA_VERIFY_URL=
MFA_VERIFY_BEARER_TOKEN=

# Development data and private media adapters
DATA_ADAPTER=mock
MEDIA_STORAGE_PROVIDER=local_mock
LOCAL_MEDIA_ROOT=.local-data/media

# PostgreSQL (Cloudways or another PostgreSQL provider)
DATABASE_URL=postgresql://archive_user:replace-me@127.0.0.1:5432/hmmsa_archive
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# One-time initial-admin bootstrap inputs. Supply transiently; do not persist the password.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MFA_REFERENCE=

# Internal AI: an OpenAI-compatible self-hosted endpoint such as Hermes via vLLM/Ollama
INTERNAL_AI_PROVIDER=local_openai_compatible
LOCAL_AI_BASE_URL=http://127.0.0.1:8000
LOCAL_AI_MODEL=replace-with-local-model-id
LOCAL_AI_AUTH_TOKEN=

# External research only; disabled unless all values are explicitly configured
EXTERNAL_RESEARCH_PROVIDER=mock
OPENAI_EXTERNAL_RESEARCH_ENABLED=false
OPENAI_RESEARCH_MODEL=
OPENAI_API_KEY=
