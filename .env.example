# Public presentation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMING_SOON=true

# Development-only authentication (never enable in production)
DEV_AUTH_ENABLED=true
AUTH_PROVIDER=development
AUTH_SESSION_SECRET=replace-with-a-long-random-local-development-value

# Temporary staging policy. Set true before production staff access is enabled.
STAFF_MFA_REQUIRED=false

# Staff MFA verification hook. Required when STAFF_MFA_REQUIRED=true.
MFA_PROVIDER=unconfigured
MFA_VERIFY_URL=
MFA_VERIFY_BEARER_TOKEN=

# Development data and private media adapters
DATA_ADAPTER=mock
MEDIA_STORAGE_PROVIDER=local_mock
LOCAL_MEDIA_ROOT=.local-data/media

# PostgreSQL (Cloudways or another PostgreSQL provider)
DATABASE_URL=postgresql://archive_user:replace-me@127.0.0.1:5432/hmmsa_archive
DATABASE_SSL=disable
DATABASE_POOL_MAX=2
DATABASE_AUTO_MIGRATE=false

# Encrypted private Archive Intake (exactly 32 random bytes, base64 encoded).
# Store the master key outside Cloudways too; database backups cannot decrypt
# originals without it. All originals begin quarantined.
DEMO_ARCHIVE_MASTER_KEY=
DEMO_ARCHIVE_KEY_VERSION=1

# One-time initial-admin bootstrap inputs. Supply transiently; do not persist the password.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MFA_REFERENCE=

# Controlled empty-database bootstrap used by the Cloudways Robin demo. When
# enabled at startup, it creates one dual admin/curator identity and then
# becomes an idempotent no-op for that same account. Use a 16+ character
# password and Sensitive variables. It refuses a non-empty unrelated database.
BOOTSTRAP_CURATOR_EMAIL=
BOOTSTRAP_CURATOR_DISPLAY_NAME=
BOOTSTRAP_CURATOR_PASSWORD=
BOOTSTRAP_CURATOR_MFA_REFERENCE=
# Emergency one-time credential handoff only. Requires the normal controlled
# bootstrap variables and the exact literal ROTATE_INITIAL_ROBIN_CURATOR_PASSWORD.
# Remove this and every BOOTSTRAP_* variable immediately after verification.
BOOTSTRAP_ROTATE_PASSWORD_CONFIRM=
BOOTSTRAP_ROTATION_ID=

# Internal AI: an OpenAI-compatible self-hosted endpoint such as Hermes via vLLM/Ollama
INTERNAL_AI_PROVIDER=local_openai_compatible
LOCAL_AI_BASE_URL=http://127.0.0.1:8000
LOCAL_AI_MODEL=replace-with-local-model-id
LOCAL_AI_AUTH_TOKEN=
# Required comma-separated exact hostname allowlist (hostnames only, no ports).
# Loopback must also be listed explicitly; a missing/empty list uses fallback.
# OpenAI, ChatGPT, Codex/OpenAI, and Azure OpenAI hosts are always rejected here.
LOCAL_AI_ALLOWED_HOSTS=127.0.0.1

# External research is disabled unless every provider, accounting, budget,
# and alert value is explicitly configured. OPENAI_API_KEY is also reused only
# by the owner-only Susanne Realtime/retrieval routes when their separate kill
# switch is enabled; it is never exposed to browser code. Each research request must
# independently include confirmed=true plus the exact non-environment runtime
# acknowledgement CLICKSMITH_PAYS_OPENAI_FEES after the paid-search notice.
EXTERNAL_RESEARCH_PROVIDER=mock
OPENAI_EXTERNAL_RESEARCH_ENABLED=false
OPENAI_RESEARCH_MODEL=
OPENAI_API_KEY=

# Private owner-only conversation with Susanne's testimony. The model and
# built-in OpenAI voice are pinned in server code. Keep disabled until the
# exact normalized login email and private vector store are reviewed in
# production. The routes fail closed when the owner email is absent; the store
# ID is fixed server-side and is never accepted from a browser request.
SUSANNE_AI_ENABLED=false
SUSANNE_OWNER_EMAIL=
SUSANNE_VECTOR_STORE_ID=

# External AI budget governance shared by research and private Susanne Realtime.
# auto uses PostgreSQL whenever DATABASE_URL is present; without a database it
# exposes a non-durable demo ledger. Live OpenAI calls require the durable
# PostgreSQL ledger and fail closed if it is unavailable. Each successful
# Realtime start reserves the full per-request ceiling for its 15-minute session
# accounting window because browser WebRTC has no trusted final-usage callback.
EXTERNAL_AI_USAGE_STORE=auto
EXTERNAL_AI_DATABASE_POOL_MAX=2
EXTERNAL_AI_MAX_QUERY_CHARACTERS=800
EXTERNAL_AI_MAX_OUTPUT_TOKENS=900
EXTERNAL_AI_MAX_TOKENS_PER_REQUEST=5000
EXTERNAL_AI_DAILY_REQUEST_LIMIT=25
EXTERNAL_AI_MONTHLY_REQUEST_LIMIT=250
EXTERNAL_AI_DAILY_TOKEN_LIMIT=60000
EXTERNAL_AI_MONTHLY_TOKEN_LIMIT=600000
EXTERNAL_AI_ALERT_THRESHOLD_PERCENT=80

# Required before live OpenAI research can run. Alerts contain only aggregate
# usage counters and go to support@clicksmith.net; no query or archive content.
EXTERNAL_AI_USAGE_ALERT_PROVIDER=smtp
EXTERNAL_AI_USAGE_ALERT_TO=support@clicksmith.net
# Cloudways Elastic Email SMTP. These are server-only variables; never add a
# NEXT_PUBLIC_ prefix. Keep SMTP_USER and SMTP_PASSWORD Sensitive in Cloudways.
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@voicesoftheshoah.org
# Legacy Resend adapter (used only when the provider above is `resend`).
EXTERNAL_AI_USAGE_ALERT_FROM=HMMSA Archive Alerts <alerts@replace-with-verified-domain.example>
RESEND_API_KEY=

# Shared read-only account for showing the survivor registry. It reaches the
# registry only, and every record it receives has contact details redacted.
# Remove these variables and redeploy once the account exists.
BOOTSTRAP_VIEWER_CONFIRM=
BOOTSTRAP_VIEWER_EMAIL=
BOOTSTRAP_VIEWER_DISPLAY_NAME=
BOOTSTRAP_VIEWER_PASSWORD=

# Publishes the reviewed survivor records into the public catalog on startup.
# Remove after the records exist.
SEED_CONFIRM=
